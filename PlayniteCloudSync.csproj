<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Playnite itself runs on .NET Framework 4.6.2 - plugins must target the same. -->
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets `dotnet build` compile a net462 target without a full Visual Studio / Framework install. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PlayniteSDK" Version="6.11.0" />
    <!-- Pinned to match Playnite's own bundled Newtonsoft.Json assembly version (10.0.0.0)
         exactly. Playnite's packer (Toolbox pack) strips same-named DLLs from .pext files on
         the assumption the host already provides them - it doesn't check version, so a newer
         Newtonsoft.Json here would compile fine but fail at runtime with a FileLoadException
         once actually installed via .pext (manual folder-copy deploys masked this, since that
         path keeps our own copy alongside the plugin). NuGet flags a known high-severity CVE
         in 10.0.3 (GHSA-5crp-9r3c-p9vr, insecure deserialization) - not applicable here, since
         that requires TypeNameHandling set to Auto/All/Objects and we never set it (default
         None), and every DeserializeObject call below targets a known plain POCO, never an
         attacker-chosen type. -->
    <PackageReference Include="Newtonsoft.Json" Version="10.0.3" />
    <!-- Reads the PlayniteAchievements plugin's own SQLite cache (achievement_cache.db)
         read-only, to push achievement counts alongside the rest of the library. Bundles
         native e_sqlite3.dll for both x86/x64 under runtimes/, auto-selected at load time by
         SQLitePCLRaw - unlike Newtonsoft.Json above, this file name doesn't collide with
         anything Playnite itself bundles, so Toolbox's pack step (which strips DLLs matching
         Playnite's own file names) shouldn't touch it, but verify against a real .pext install
         before trusting that. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="7.0.20" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Settings UI is built in plain C# (no .xaml file), so these framework references are
         enough - no need for the WindowsDesktop SDK / XAML markup compiler. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
